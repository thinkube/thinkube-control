# Build stage - use optimized base from library
ARG CONTAINER_REGISTRY
# node-base carries git, which npm needs to install thinkube-style
FROM ${CONTAINER_REGISTRY}/library/node-base:22-alpine AS build-stage
WORKDIR /app

COPY package*.json ./
RUN if [ -f package-lock.json ]; then npm ci; else npm install; fi
COPY . .
RUN npm run build

# Runtime stage - minimal image for serving built files
ARG CONTAINER_REGISTRY
FROM ${CONTAINER_REGISTRY}/library/nginx:stable-alpine AS runtime-stage
COPY --from=build-stage /app/dist /usr/share/nginx/html
COPY nginx.conf /etc/nginx/conf.d/default.conf

# nginx runs this before it starts, rewriting config.js from the environment
COPY public-config.sh /docker-entrypoint.d/40-public-config.sh
RUN chmod +x /docker-entrypoint.d/40-public-config.sh

EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
