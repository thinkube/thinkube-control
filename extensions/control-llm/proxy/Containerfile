# The LLM gateway's proxy at llm.<domain>. The extension's build passes the
# cluster registry as CONTAINER_REGISTRY, as for its other containers.
ARG CONTAINER_REGISTRY

# Stage 1: Build
FROM ${CONTAINER_REGISTRY}/library/golang:1.27-alpine AS builder
WORKDIR /app
COPY go.mod go.sum ./
RUN go mod download
COPY . .
# The unit tests gate the image: a failing test stops the build.
RUN CGO_ENABLED=0 go test ./...
RUN CGO_ENABLED=0 GOOS=linux go build -o /llm-proxy ./cmd/proxy

# Stage 2: Runtime
ARG CONTAINER_REGISTRY
FROM ${CONTAINER_REGISTRY}/library/alpine:latest
RUN apk --no-cache add ca-certificates
COPY --from=builder /llm-proxy /usr/local/bin/llm-proxy
EXPOSE 8080
ENTRYPOINT ["/usr/local/bin/llm-proxy"]
