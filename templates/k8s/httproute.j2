#jinja2: lstrip_blocks: True, trim_blocks: True
# Generated HTTPRoute configuration (Gateway API)
# Routes traffic through thinkube-gateway in gateway-system namespace
# Every rule allows a request 600s, as the LLM gateway's route does: Envoy's
# default of 15s ends a long response, such as a streamed LLM answer, midway.
{# A route with host (an extension's platform address, such as llm) is served by an HTTPRoute of its own at
   <host>.<domain>; every other route at the app's own address #}
{% set all_routes = thinkube_spec.spec.routes | default([]) %}
{% set routes = all_routes | rejectattr('host', 'defined') | list %}
{% set hosts = all_routes | selectattr('host', 'defined') | map(attribute='host') | unique | list %}
{% set containers_with_ports = thinkube_spec.spec.containers | selectattr('port', 'defined') | list %}
---
apiVersion: gateway.networking.k8s.io/v1
kind: HTTPRoute
metadata:
  name: {{ project_name }}
  namespace: {{ k8s_namespace }}
  labels:
    app.kubernetes.io/name: {{ project_name }}
    app.kubernetes.io/managed-by: argocd
spec:
  parentRefs:
    - name: thinkube-gateway
      namespace: gateway-system
      sectionName: https
  hostnames:
    - "{{ project_name }}.{{ domain_name }}"
  rules:
{% if routes %}
  {% for route in routes %}
    {% set container = thinkube_spec.spec.containers | selectattr('name', 'equalto', route.to) | first %}
    {% if container is defined and container.port is defined %}
    - matches:
        - path:
            type: PathPrefix
            value: "{{ route.path }}"
      backendRefs:
        - name: {{ (project_name ~ '-') if extension else '' }}{{ container.name }}
          port: {{ container.port }}
      timeouts:
        request: 600s
    {% endif %}
  {% endfor %}
{% elif containers_with_ports and not all_routes %}
    - matches:
        - path:
            type: PathPrefix
            value: "/"
      backendRefs:
        - name: {{ (project_name ~ '-') if extension else '' }}{{ containers_with_ports[0].name }}
          port: {{ containers_with_ports[0].port }}
      timeouts:
        request: 600s
{% endif %}
{% for host in hosts %}
---
apiVersion: gateway.networking.k8s.io/v1
kind: HTTPRoute
metadata:
  name: {{ project_name }}-{{ host }}
  namespace: {{ k8s_namespace }}
  labels:
    app.kubernetes.io/name: {{ project_name }}
    app.kubernetes.io/managed-by: argocd
spec:
  parentRefs:
    - name: thinkube-gateway
      namespace: gateway-system
      sectionName: https
  hostnames:
    - "{{ host }}.{{ domain_name }}"
  rules:
  {% for route in all_routes | selectattr('host', 'defined') | selectattr('host', 'equalto', host) %}
    {% set container = thinkube_spec.spec.containers | selectattr('name', 'equalto', route.to) | first %}
    - matches:
        - path:
            type: PathPrefix
            value: "{{ route.path }}"
      backendRefs:
        - name: {{ (project_name ~ '-') if extension else '' }}{{ container.name }}
          port: {{ container.port }}
      timeouts:
        request: 600s
  {% endfor %}
{% endfor %}
